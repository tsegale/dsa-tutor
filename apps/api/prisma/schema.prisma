generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  EDUCATOR
}

enum Track {
  FOUNDATIONS
  SORTING
  TREES
  GRAPHS
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Mode {
  DEMO
  PRACTICE
  HANDS_ON
}

enum ScaffoldingLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(STUDENT)
  name           String
  xpTotal        Int       @default(0)
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())

  sessions    Session[]
  userBadges  UserBadge[]
}

model AlgorithmTopic {
  id               String     @id @default(cuid())
  name             String     @unique
  displayName      String
  track            Track
  difficulty       Difficulty
  description      String
  estimatedMinutes Int
  isLocked         Boolean    @default(false)
  createdAt        DateTime   @default(now())

  sessions Session[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  algorithmTopicId String
  mode             Mode
  scaffoldingLevel ScaffoldingLevel
  startTime        DateTime  @default(now())
  endTime          DateTime?
  completed        Boolean   @default(false)

  user           User           @relation(fields: [userId], references: [id])
  algorithmTopic AlgorithmTopic @relation(fields: [algorithmTopicId], references: [id])
  interactions   Interaction[]

  @@index([userId])
  @@index([algorithmTopicId])
}

model Interaction {
  id                      String   @id @default(cuid())
  sessionId               String
  stepIndex               Int
  predictionSubmitted     String?
  predictionCorrect       Boolean?
  misconceptionCategory   String?
  hintsRequested          Int      @default(0)
  timeSpentSeconds        Int
  criticalJunctionType    String?
  junctionDifficulty      String?
  scaffoldingLevelAtTime  String   @default("MEDIUM")
  masteryScoreAtTime      Int      @default(0)
  createdAt               DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Badge {
  id             String @id @default(cuid())
  name           String @unique
  description    String
  iconName       String
  awardCondition String

  userBadges UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}
