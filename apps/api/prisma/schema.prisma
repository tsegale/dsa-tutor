generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  EDUCATOR
}

enum Track {
  FOUNDATIONS
  SORTING
  TREES
  GRAPHS
  SEARCHING
  TECHNIQUES
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Mode {
  DEMO
  PRACTICE
  HANDS_ON
  FEYNMAN
  CODE
  CHALLENGE
}

enum Condition {
  CONTROL
  TREATMENT
}

enum ScaffoldingLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(STUDENT)
  name           String
  xpTotal        Int       @default(0)
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())

  // Study protocol fields - null for a normal account, populated only for
  // an account enrolled as a research participant.
  participantCode String?    @unique
  condition       Condition?
  consentAt       DateTime?
  withdrawnAt     DateTime?

  sessions            Session[]
  userBadges          UserBadge[]
  topicMasteries      TopicMastery[]
  assessmentResponses AssessmentResponse[]
}

model AlgorithmTopic {
  id               String     @id @default(cuid())
  name             String     @unique
  displayName      String
  track            Track
  difficulty       Difficulty
  description      String
  estimatedMinutes Int
  isLocked         Boolean    @default(false)
  order            Int        @default(999)
  createdAt        DateTime   @default(now())

  sessions       Session[]
  topicMasteries TopicMastery[]
}

model Session {
  id                   String           @id @default(cuid())
  userId               String
  algorithmTopicId     String
  mode                 Mode
  scaffoldingLevel     ScaffoldingLevel
  startTime            DateTime         @default(now())
  endTime              DateTime?
  completed            Boolean          @default(false)
  challengeExplanation String?

  user           User           @relation(fields: [userId], references: [id])
  algorithmTopic AlgorithmTopic @relation(fields: [algorithmTopicId], references: [id])
  interactions   Interaction[]

  @@index([userId])
  @@index([algorithmTopicId])
}

model Interaction {
  id                     String   @id @default(cuid())
  sessionId              String
  stepIndex              Int
  predictionSubmitted    String?
  predictionCorrect      Boolean?
  misconceptionCategory  String?
  hintsRequested         Int      @default(0)
  timeSpentSeconds       Int
  criticalJunctionType   String?
  junctionDifficulty     String?
  scaffoldingLevelAtTime String   @default("MEDIUM")
  masteryScoreAtTime     Int      @default(0)
  interactionType        String   @default("PREDICTION")
  createdAt              DateTime @default(now())

  // What the student actually saw from the feedback mechanism - without
  // these the platform's core contribution (AI-generated, scaffolding-
  // calibrated feedback) leaves no trace for the study to evaluate.
  aiGenerated             Boolean @default(false)
  feedbackText            String?
  hintText                String?
  counterfactualText      String?
  aiMisconceptionCategory String?
  bottomedOut             Boolean @default(false)
  hintIndexAtResolve      Int     @default(0)
  aiLatencyMs             Int?
  aiModel                 String?
  promptVersion           String?

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Badge {
  id             String @id @default(cuid())
  name           String @unique
  description    String
  iconName       String
  awardCondition String

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// Per-topic mastery, written at session end. This is what the dashboard's
// mastery rings and any retention analysis read - Interaction rows alone
// require re-deriving it from scratch every time it's needed.
model TopicMastery {
  id                 String   @id @default(cuid())
  userId             String
  algorithmTopicId   String
  overallScore       Int
  conceptualScore    Int
  proceduralScore    Int
  totalPredictions   Int
  correctPredictions Int
  lastPracticedAt    DateTime
  updatedAt          DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  algorithmTopic AlgorithmTopic @relation(fields: [algorithmTopicId], references: [id])

  @@unique([userId, algorithmTopicId])
}

enum AssessmentType {
  PRE_TEST
  POST_TEST
}

// Pre-test/post-test items, so the comparison against passive visualisers
// (the study's control condition) can be run inside the platform instead
// of joined by hand from a separate form.
model Assessment {
  id        String         @id @default(cuid())
  name      String         @unique
  type      AssessmentType
  createdAt DateTime       @default(now())

  responses AssessmentResponse[]
}

model AssessmentResponse {
  id            String   @id @default(cuid())
  userId        String
  assessmentId  String
  // Identifies which item within the assessment this answers - the
  // assessment's own item bank/ordering lives outside the database (the
  // same way Interaction.criticalJunctionType references a client-side
  // concept rather than a normalised table).
  itemId        String
  responseValue String
  isCorrect     Boolean?
  submittedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
}
