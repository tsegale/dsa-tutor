generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  EDUCATOR
}

enum Track {
  FOUNDATIONS
  SORTING
  TREES
  GRAPHS
  SEARCHING
  TECHNIQUES
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Mode {
  DEMO
  PRACTICE
  HANDS_ON
  FEYNMAN
  CODE
  CHALLENGE
}

enum Condition {
  CONTROL
  TREATMENT
}

enum ScaffoldingLevel {
  HIGH
  MEDIUM
  LOW
  NONE
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(STUDENT)
  name           String
  xpTotal        Int       @default(0)
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())

  // Study protocol fields - null for a normal account, populated only for
  // an account enrolled as a research participant.
  participantCode String?    @unique
  condition       Condition?
  consentAt       DateTime?
  withdrawnAt     DateTime?

  sessions           Session[]
  userBadges         UserBadge[]
  topicMasteries     TopicMastery[]
  assessmentAttempts AssessmentAttempt[]
}

model AlgorithmTopic {
  id               String     @id @default(cuid())
  name             String     @unique
  displayName      String
  track            Track
  difficulty       Difficulty
  description      String
  estimatedMinutes Int
  isLocked         Boolean    @default(false)
  order            Int        @default(999)
  createdAt        DateTime   @default(now())

  sessions       Session[]
  topicMasteries TopicMastery[]
}

model Session {
  id                   String           @id @default(cuid())
  userId               String
  algorithmTopicId     String
  mode                 Mode
  scaffoldingLevel     ScaffoldingLevel
  startTime            DateTime         @default(now())
  endTime              DateTime?
  completed            Boolean          @default(false)
  challengeExplanation String?

  // Self-report cognitive load/confidence measures, taken once at session
  // end (see SessionEndSurvey.tsx) - a Paas-style 1-9 mental effort item
  // and a 1-5 confidence item. Both null if the student skipped it.
  mentalEffort Int?
  confidence   Int?

  user           User           @relation(fields: [userId], references: [id])
  algorithmTopic AlgorithmTopic @relation(fields: [algorithmTopicId], references: [id])
  interactions   Interaction[]

  @@index([userId])
  @@index([algorithmTopicId])
}

model Interaction {
  id                     String   @id @default(cuid())
  sessionId              String
  stepIndex              Int
  predictionSubmitted    String?
  predictionCorrect      Boolean?
  misconceptionCategory  String?
  hintsRequested         Int      @default(0)
  timeSpentSeconds       Int
  criticalJunctionType   String?
  junctionDifficulty     String?
  scaffoldingLevelAtTime String   @default("MEDIUM")
  masteryScoreAtTime     Int      @default(0)
  interactionType        String   @default("PREDICTION")
  createdAt              DateTime @default(now())

  // What the student actually saw from the feedback mechanism - without
  // these the platform's core contribution (AI-generated, scaffolding-
  // calibrated feedback) leaves no trace for the study to evaluate.
  aiGenerated             Boolean @default(false)
  feedbackText            String?
  hintText                String?
  counterfactualText      String?
  aiMisconceptionCategory String?
  bottomedOut             Boolean @default(false)
  hintIndexAtResolve      Int     @default(0)
  aiLatencyMs             Int?
  aiModel                 String?
  promptVersion           String?

  // Captured at submission time so a human rater reviewing an incorrect
  // interaction later (see MisconceptionRating) can see what the student
  // was actually looking at, not just the step index.
  dataStructureStateSnapshot Json?

  session          Session               @relation(fields: [sessionId], references: [id])
  misconceptionRatings MisconceptionRating[]

  @@index([sessionId])
}

// An independent human label on a sampled incorrect interaction, imported
// from a CSV a second rater filled in outside the platform - the sanity
// check for the rule-based misconceptionCategory, in place of a full
// inter-rater kappa workflow.
model MisconceptionRating {
  id            String   @id @default(cuid())
  interactionId String
  raterCode     String
  label         String
  createdAt     DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@unique([interactionId, raterCode])
  @@index([interactionId])
}

model Badge {
  id             String @id @default(cuid())
  name           String @unique
  description    String
  iconName       String
  awardCondition String

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// Per-topic mastery, written at session end. This is what the dashboard's
// mastery rings and any retention analysis read - Interaction rows alone
// require re-deriving it from scratch every time it's needed.
model TopicMastery {
  id                 String   @id @default(cuid())
  userId             String
  algorithmTopicId   String
  overallScore       Int
  conceptualScore    Int
  proceduralScore    Int
  totalPredictions   Int
  correctPredictions Int
  lastPracticedAt    DateTime
  updatedAt          DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  algorithmTopic AlgorithmTopic @relation(fields: [algorithmTopicId], references: [id])

  @@unique([userId, algorithmTopicId])
}

enum AssessmentPhase {
  PRE
  POST
}

enum AssessmentItemType {
  MULTIPLE_CHOICE
  TRACE
}

// The independent outcome measure. Deliberately separate from mastery
// score/Interaction: those are computed from the same predictions the
// tutor trains and scaffolds on, so they cannot also be the measure used
// to judge whether the tutor worked.
model Assessment {
  id         String          @id @default(cuid())
  code       String          @unique
  phase      AssessmentPhase
  title      String
  version    String          @default("1.0")
  topicSlugs String[]
  createdAt  DateTime        @default(now())

  items    AssessmentItem[]
  attempts AssessmentAttempt[]
}

model AssessmentItem {
  id           String             @id @default(cuid())
  assessmentId String
  order        Int
  itemType     AssessmentItemType
  stem         String
  options      Json?
  // For MULTIPLE_CHOICE, the id of the correct option within `options`.
  // For TRACE, the canonical exact-match answer string - the schema gives
  // this one correctness field for both item types rather than a second
  // TRACE-only column.
  correctOptionId String?
  conceptTag      String
  maxScore        Int      @default(1)

  assessment Assessment           @relation(fields: [assessmentId], references: [id])
  responses  AssessmentResponse[]

  @@index([assessmentId])
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  userId       String
  assessmentId String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  totalScore   Int?

  user       User                 @relation(fields: [userId], references: [id])
  assessment Assessment           @relation(fields: [assessmentId], references: [id])
  responses  AssessmentResponse[]

  @@unique([userId, assessmentId])
}

model AssessmentResponse {
  id               String   @id @default(cuid())
  attemptId        String
  itemId           String
  response         String
  isCorrect        Boolean?
  score            Int?
  timeSpentSeconds Int
  submittedAt      DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id])
  item    AssessmentItem    @relation(fields: [itemId], references: [id])

  @@unique([attemptId, itemId])
  @@index([attemptId])
}
