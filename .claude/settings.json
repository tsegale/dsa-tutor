{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(npx prisma:*)",
      "Bash(npx vitest:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose logs:*)"
    ],
    "deny": [
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(npx prisma db push --force-reset:*)",
      "Bash(npx prisma migrate reset:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== DSA Tutor Session Start ===' && git log --oneline -5 2>/dev/null && echo '' && echo 'Branch:' && git branch --show-current 2>/dev/null && echo '' && grep -A3 'Current focus' CLAUDE.md 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
